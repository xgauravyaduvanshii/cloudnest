{
  "name": "cloudnest-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "db:push": "npm run db:migrate",
    "db:migrate": "ts-node --files src/db/migrate.ts",
    "db:seed": "ts-node --files src/db/seed.ts",
    "build": "tsc && cp ./package.json ./dist",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
