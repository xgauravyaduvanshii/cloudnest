# CloudNest backend environment — copy to `.env` and fill in real values.
# NEVER commit a filled-in .env. Secrets (JWT, encryption, provider keys, AI key)
# stay server-side only and are never returned to the client.

# ---- Core ----
NODE_ENV=development
PORT=3000
BASE_PATH=/api
API_PUBLIC_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://user:password@localhost:5432/cloudnest

# ---- Auth ----
# Use long, random strings in production.
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRES_IN=1d
# 32+ char key used to encrypt stored provider credentials (AES-256-GCM).
ENCRYPTION_KEY=change_me_32_plus_char_secret
ADMIN_EMAIL=demo@example.com

# ---- CORS / logging ----
ALLOWED_ORIGINS=http://localhost:5173,https://cloudnest.vercel.app
LOG_LEVEL=info
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=

# ---- AWS S3 / R2 (optional) ----
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ---- Google Drive OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/storage-accounts/google/callback

# ---- Telegram storage (optional) ----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Upload worker ----
UPLOAD_TMP_DIR=
UPLOAD_WORKER_CONCURRENCY=4

# ---- Public API v1 rate limiting ----
# Requests per API key per minute (fixed window).
API_RATE_LIMIT_PER_MIN=120

# ---- AI (Phase 3). Server-side only; never exposed to the frontend. ----
# Any OpenAI-compatible provider works (OpenAI, Groq, Together, Fireworks, Ollama).
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_OUTPUT_TOKENS=1024
