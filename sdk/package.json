{
  "name": "@cloudnest/sdk",
  "version": "1.1.0",
  "description": "The official TypeScript library for the CloudNest API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "changeset": "npx changeset",
    "version-packages": "npx changeset version",
    "release": "npm run build && npm run version-packages && npx changeset publish",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "url": "git+https://github.com/xgauravyaduvanshii/cloudnest.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cloudnest",
    "file-upload",
    "storage",
    "typescript",
    "nodejs",
    "nextjs"
  ],
  "author": "xgauravyaduvanshii",
  "license": "SEE LICENSE IN ../LICENSE",
  "dependencies": {
    "form-data": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
